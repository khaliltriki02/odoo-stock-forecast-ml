<odoo>
    <record id="view_stock_forecast_form" model="ir.ui.view">
        <field name="name">stock.forecast.form</field>
        <field name="model">stock.forecast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_forecast" type="object"
                            string="Lancer la prévision" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="forecast_date"/>
                        <field name="model_used"/>
                    </group>
                    <group>
                        <field name="predicted_demand" readonly="1"/>
                        <field name="predicted_stock_level" readonly="1"/>
                        <field name="reorder_point_suggested" readonly="1"/>
                        <field name="estimated_stockout_date" readonly="1"/>
                        <field name="stockout_risk" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_forecast_tree" model="ir.ui.view">
        <field name="name">stock.forecast.tree</field>
        <field name="model">stock.forecast</field>
        <field name="arch" type="xml">
            <tree decoration-danger="stockout_risk == 'high'" decoration-warning="stockout_risk == 'medium'">
                <field name="product_id"/>
                <field name="forecast_date"/>
                <field name="predicted_demand"/>
                <field name="predicted_stock_level"/>
                <field name="stockout_risk"/>
                <field name="reorder_point_suggested"/>
            </tree>
        </field>
    </record>

    <record id="action_stock_forecast" model="ir.actions.act_window">
        <field name="name">Prévisions de stock</field>
        <field name="res_model">stock.forecast</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stock_forecast_root" name="ML Forecast" parent="stock.menu_stock_root" sequence="50"/>
    <menuitem id="menu_stock_forecast" name="Prévisions" parent="menu_stock_forecast_root" action="action_stock_forecast"/>
</odoo>